{
  "manifest_version": 3,
  "name": "Privacy Policy Analyzer",
  "version": "1.0",
  "description": "Extracts and analyzes privacy policies from webpages",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/privacy-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/images/pactLogo.jpg",
      "48": "assets/images/pactLogo.jpg",
      "128": "assets/images/pactLogo.jpg"
    }
  },
  "icons": {
    "16": "assets/images/pactLogo.jpg",
    "48": "assets/images/pactLogo.jpg",
    "128": "assets/images/pactLogo.jpg"
  }
}